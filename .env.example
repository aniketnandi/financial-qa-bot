# Copy to .env and fill in ONE provider.

# Which LLM backend to use: gemini (default) or azure_openai
LLM_PROVIDER=gemini

# Gemini: free key at https://aistudio.google.com
GEMINI_API_KEY=your_actual_key_here

# Azure OpenAI (LLM_PROVIDER=azure_openai): see docs/DEPLOY_AZURE.md
# AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o-mini
# AZURE_OPENAI_API_VERSION=2024-10-21

# Optional: require an X-API-Key header on /ask and /ask_agent
# API_KEY=
